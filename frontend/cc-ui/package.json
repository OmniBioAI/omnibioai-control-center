{
  "name": "cc-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-build-env.cjs && tsc -b && vite build",
    "build:admin": "node scripts/check-build-env.cjs && tsc -b && VITE_APP_MODE=admin vite build",
    "build:control": "node scripts/check-build-env.cjs && tsc -b && VITE_APP_MODE=control vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e:admin": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:admin:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "build:control:studio": "node scripts/check-build-env.cjs && tsc -b && VITE_APP_MODE=control VITE_API_BASE=/_svc/control vite build --base=/_svc/control/ --outDir=dist-control-studio"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "@playwright/test": "^1.62.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vite": "^6.0.1",
    "vitest": "^2.1.9"
  }
}
